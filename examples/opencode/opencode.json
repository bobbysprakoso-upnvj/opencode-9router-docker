{
  "model": "9router/coding-agent",
  "small_model": "9router/utility-fast",
  "plugin": [],
  "skills": {
    "paths": ["/home/opencode/.config/opencode/superpowers/skills"]
  },
  "permission": {
    "external_directory": {
      "/knowledge/Second-Brain/**": "allow",
      "/home/opencode/.config/opencode/gsd-core/**": "allow"
    },
    "read": {
      "/knowledge/Second-Brain/**": "allow",
      "/home/opencode/.config/opencode/gsd-core/**": "allow"
    },
    "edit": {
      "/knowledge/Second-Brain/**": "deny"
    }
  },
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://9router:20128/v1",
        "apiKey": "{env:ROUTER9_API_KEY}"
      },
      "models": {
        "utility-fast": {
          "name": "Utility Fast"
        },
        "coding-agent": {
          "name": "Coding Agent"
        },
        "coding-deep": {
          "name": "Coding Deep"
        },
        "coding-review": {
          "name": "Coding Review"
        },
        "research-deep": {
          "name": "Research Deep"
        },
        "research-write": {
          "name": "Research Write"
        },
        "research-engineer": {
          "name": "Research Engineer"
        },
        "research-review": {
          "name": "Research Review"
        },
        "private-local": {
          "name": "Private Local"
        },
        "ag/gemini-3.6-flash-high": {
          "name": "Emergency Direct Gemini"
        }
      }
    }
  }
}
