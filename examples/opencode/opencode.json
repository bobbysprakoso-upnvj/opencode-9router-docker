{
  "model": "9router/ag/gemini-3-flash-agent",
  "small_model": "9router/ag/gemini-3.6-flash-low",

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",

      "options": {
        "baseURL": "http://9router:20128/v1",
        "apiKey": "{env:ROUTER9_API_KEY}"
      },

      "models": {
        "coding-fast": {
          "name": "9Router Coding Fast"
        },

        "coding-deep": {
          "name": "9Router Coding Deep"
        },

        "ag/gemini-3-flash-agent": {
          "name": "Gemini 3 Flash Agent",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },

        "ag/gemini-3.6-flash-high": {
          "name": "Gemini 3.6 Flash High",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },

        "ag/gemini-3.6-flash-medium": {
          "name": "Gemini 3.6 Flash Medium",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },

        "ag/gemini-3.6-flash-low": {
          "name": "Gemini 3.6 Flash Low",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}
